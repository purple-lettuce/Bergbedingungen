nt_weak_layers","period":"later","elevation":{"lower_bound":2800},"aspects":["N","NE","NW"],"snowpack_stability":"poor","frequency":"none","avalanche_size":2}],"text":{"summary":"Schwachschichten im Altschnee erfordern Vorsicht. Nassschnee kritisch beurteilen.","sections":[{"blocks":[{"type":"paragraph","text":"Mit der Erwärmung steigt die Lawinengefahr im Tagesverlauf allmählich an. Die feuchten Lawinen können an sehr steilen Hängen spontan abgehen und vereinzelt mittlere Größe erreichen."},{"type":"paragraph","text":"Mit Wind entstanden am Freitag in hohen Lagen Triebschneeansammlungen. Einzelne Gefahrenstellen liegen an sehr steilen Schattenhängen oberhalb von rund 2600 m."},{"type":"paragraph","text":"Lawinen können mit meist großer Belastung ausgelöst werden und mittlere Größe erreichen."}],"key":"activity"},{"blocks":[{"type":"paragraph","text":"Unterhalb von rund 2500 m liegt wenig Schnee. Die frühlingshaften Wetterbedingungen führen zu einer raschen Anfeuchtung der Schneedecke. Die Schneeoberfläche gefriert nur in hohen Lagen tragfähig und weicht rasch auf."},{"type":"paragraph","text":"Steile Nordwest-, Nord- und Nordosthänge oberhalb von rund 2500 m: Im unteren Teil der Altschneedecke sind kantig aufgebaute Schwachschichten vorhanden."}],"key":"snowpack"}],"tendency":[{"highlights":"Am Morgen herrschen allgemein günstige Verhältnisse. Anstieg der Gefahr von nassen Lawinen mit der tageszeitlichen Erwärmung und der Sonneneinstrahlung.","type":"steady","validity_period":{"start":"2026-05-03T15:00:00Z","end":"2026-05-04T15:00:00Z"}}]},"danger_patterns":["DP10"]},{"id":"b5d8aade-41ef-40d6-a2dc-3b753c009979","source":"euregio","publication_time":"2026-05-02T15:00:00Z","validity_period":{"start":"2026-05-02T15:00:00Z","end":"2026-05-03T15:00:00Z"},"unscheduled":false,"max_level":1,"main_date":"2026-05-03","danger_ratings":[{"value":"low","level":1,"period":"all_day"}],"danger_by_elevation":[{"basis":"danger_rating","period":"all_day","value":"low","level":1}],"el